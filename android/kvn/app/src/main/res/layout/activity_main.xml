<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/kvn_background"
    android:fillViewport="true"
    android:clipToPadding="false">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:paddingStart="18dp" android:paddingEnd="18dp"
        android:paddingTop="12dp" android:paddingBottom="28dp">

        <ImageView android:id="@+id/brand_banner" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:adjustViewBounds="true"
            android:scaleType="fitCenter" android:src="@drawable/kvn_brand_header"
            android:background="@drawable/brand_background"
            android:contentDescription="@string/brand_accessibility" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="10dp" android:layout_marginStart="4dp"
            android:text="@string/test_build" android:textSize="12sp" android:textColor="@color/kvn_muted" />

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="18dp" android:padding="20dp" android:orientation="vertical"
            android:background="@drawable/card">
            <TextView android:id="@+id/connection_heading" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:text="@string/connection_title"
                android:textStyle="bold" android:textSize="19sp" android:textColor="@color/kvn_ink" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="10dp" android:text="@string/connection_unavailable"
                android:textSize="23sp" android:textStyle="bold" android:textColor="@color/kvn_red_dark" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="10dp" android:text="@string/connection_note"
                android:textSize="15sp" android:lineSpacingExtra="3dp" android:textColor="@color/kvn_muted" />
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="14dp" android:padding="20dp" android:orientation="vertical"
            android:background="@drawable/card">
            <TextView android:id="@+id/rules_heading" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:text="@string/rules_title"
                android:textSize="19sp" android:textStyle="bold" android:textColor="@color/kvn_ink" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="16dp" android:orientation="horizontal" android:baselineAligned="false">
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical"
                    android:padding="12dp" android:background="@drawable/stat_background">
                    <TextView android:id="@+id/direct_count" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:text="@string/number_na"
                        android:textSize="24sp" android:textStyle="bold" android:textColor="@color/kvn_red" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="@string/route_direct" android:textSize="12sp" android:textColor="@color/kvn_ink" />
                </LinearLayout>
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:layout_marginStart="8dp"
                    android:orientation="vertical" android:padding="12dp"
                    android:background="@drawable/stat_background">
                    <TextView android:id="@+id/proxy_count" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:text="@string/number_na"
                        android:textSize="24sp" android:textStyle="bold" android:textColor="@color/kvn_red" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="@string/route_proxy" android:textSize="12sp" android:textColor="@color/kvn_ink" />
                </LinearLayout>
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:layout_marginStart="8dp"
                    android:orientation="vertical" android:padding="12dp"
                    android:background="@drawable/stat_background">
                    <TextView android:id="@+id/block_count" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:text="@string/number_na"
                        android:textSize="24sp" android:textStyle="bold" android:textColor="@color/kvn_red" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="@string/route_block" android:textSize="12sp" android:textColor="@color/kvn_ink" />
                </LinearLayout>
            </LinearLayout>
            <TextView android:id="@+id/rules_details" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="14dp"
                android:text="@string/rules_loading" android:textSize="14sp"
                android:lineSpacingExtra="2dp" android:textColor="@color/kvn_ink" />
            <TextView android:id="@+id/check_status" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="8dp"
                android:textSize="13sp" android:lineSpacingExtra="2dp"
                android:textColor="@color/kvn_muted" android:accessibilityLiveRegion="polite" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="8dp" android:text="@string/rules_note"
                android:textSize="12sp" android:lineSpacingExtra="1dp" android:textColor="@color/kvn_muted" />
            <Button android:id="@+id/refresh_rules" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="15dp"
                android:minHeight="52dp" android:padding="10dp" android:text="@string/refresh_rules" android:textAllCaps="false"
                android:textColor="@android:color/white" android:backgroundTint="@color/kvn_red" />
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="14dp" android:padding="20dp" android:orientation="vertical"
            android:background="@drawable/card">
            <TextView android:id="@+id/updates_heading" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:text="@string/app_updates_title"
                android:textSize="19sp" android:textStyle="bold" android:textColor="@color/kvn_ink" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="10dp" android:text="@string/app_updates_note"
                android:textSize="15sp" android:lineSpacingExtra="3dp" android:textColor="@color/kvn_muted" />
            <Button android:id="@+id/check_release" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="12dp"
                android:minHeight="52dp" android:padding="10dp" android:textAllCaps="false"
                android:text="@string/check_release" android:textColor="@color/kvn_red"
                android:backgroundTint="#FFF0ED" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
